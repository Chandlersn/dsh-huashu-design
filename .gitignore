# Dependencies
node_modules/
pnpm-store/

# Build/intermediate output that can be regenerated
artifacts/
*.tgz

# The upstream snapshot IS committed so a clone is immediately usable: the
# workbench shows an empty style library without its 92 specimens and handbooks.
# Only the nested clone metadata is excluded, since that history belongs to the
# upstream repository and would double the checkout size.
upstream/.git/
upstream/node_modules/

# Local environment
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Editor / OS noise
.idea/
.vscode/
*.swp
